[Unit]
Description=AlgoView AWS AMI execution agent
After=network-online.target tinyproxy.service
Wants=network-online.target
Requires=tinyproxy.service

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/algoview-ami-agent
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/tinyproxy /var/lib/algoview-node /var/log/tinyproxy /run

[Install]
WantedBy=multi-user.target
