[Unit]
Description=AlgoView Priority Exit Dispatcher
After=network.target redis-server.service postgresql.service
Requires=redis-server.service postgresql.service

[Service]
Type=simple
User=ubuntu
Group=www-data
WorkingDirectory=/var/www/sparkbridge/Backend
EnvironmentFile=/var/www/sparkbridge/Backend/.env
Environment=SKIP_INSTRUMENT_PREWARM=true
ExecStart=/var/www/sparkbridge/Backend/venv/bin/celery -A algoview worker --loglevel=INFO --queues=priority_exit_dispatch --hostname=exit-dispatcher@%%h --pool=threads --concurrency=2 --prefetch-multiplier=1 -Ofair
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
UMask=0027

[Install]
WantedBy=multi-user.target
