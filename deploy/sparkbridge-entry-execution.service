[Unit]
Description=AlgoView priority BUY entry dispatcher
After=network.target redis-server.service

[Service]
Type=simple
User=ubuntu
Group=www-data
WorkingDirectory=/var/www/sparkbridge/Backend
EnvironmentFile=-/var/www/sparkbridge/Backend/.env
ExecStart=/bin/sh -c 'exec /var/www/sparkbridge/Backend/venv/bin/celery -A algoview worker --loglevel=INFO --pool=threads --concurrency=${ENTRY_DISPATCH_WORKERS:-2} --prefetch-multiplier=1 --queues=priority_entry --hostname=sparkbridge-entry-execution@%%h -Ofair'
Restart=always
RestartSec=5
TimeoutStopSec=330
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
